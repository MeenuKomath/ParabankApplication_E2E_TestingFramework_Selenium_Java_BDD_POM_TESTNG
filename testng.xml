<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org">
<suite name="ParaBank E2E Automation Suite" verbose="1">

    <!-- Register TestNG Listener for Extent Reports & Failure Screenshots -->
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="ParaBank Smoke Tests">
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

</suite>
